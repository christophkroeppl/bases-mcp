  "cards": [
    {
      "dot": "cyan",
      "title": "Six tools, two writers",
      "items": [
        "list_bases, resolve_base, get_note and backlinks read.",
        "write_note and add_note_to_base are the only tools that write.",
        "Every tool validates arguments, calls the Resolver and shapes the answer."
      ]
    },
    {
      "dot": "amber",
      "title": "Query pipeline",
      "items": [
        "Formulas evaluate once per note, in dependency order.",
        "Global and view filters run before sort, group and limit.",
        "this binds to the Host note; an unbound this is an error, not empty rows."
      ]
    },
    {
      "dot": "violet",
      "title": "Two rendering surfaces",
      "items": [
        "resolve_base format=markdown is the flat, byte-comparable CLI-parity table.",
        "get_note replaces each Base region with a structured base-rendered fence.",
        "A Projection is never written back: Obsidian needs live YAML in a base fence."
      ]
    },
    {
      "dot": "emerald",
      "title": "Conditional writes",
      "items": [
        "base_hash is read-verify-write: a note changed since the read is refused.",
        "Base regions are restored byte-for-byte and matched by path, not position.",
        "add_note_to_base proposes, verifies against the real filter, then writes.",
        "A draft expires after 30 minutes."
      ]
    },
    {
      "dot": "rose",
      "title": "A record, not a control",
      "items": [
        "One JSON line per call and one for the initialize handshake.",
        "No note contents, credentials or error prose; 5 MB rollover keeps one generation.",
        "HTTP has no authentication, authorization or rate limiting.",
        "The network boundary is where the port is published, not where the server binds."
      ]
    }
  ]
