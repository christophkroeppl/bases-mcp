# Environment schema for bases-mcp.
#
# The binary reads the plain process environment and nothing else. This file is
# the single source of truth for which variables exist, what they accept, and
# which are secret; varlock validates it and `varlock run -- bases-mcp` injects
# the resolved values. Nothing in the server depends on varlock being present.
#
# A bare assignment sets no value, so an unset variable stays unset and the
# server applies its own default. A variable set but blank is a startup refusal
# — do not "helpfully" fill these in with empty strings.
#
# @defaultSensitive=false
# @defaultRequired=false
# ---

# --- the vault -------------------------------------------------------------

# Path to a vault directory on the local filesystem. A relative path resolves
# against the process working directory; `~` is NOT expanded.
#
# Exactly one backend must be named: this one, or the WebDAV trio below.
# BASES_MCP_VAULT wins if both are set, and says so on stderr.
# @example=/path/to/vault
# @auditIgnore
BASES_MCP_VAULT=

# Base URL of the WebDAV collection backing the vault. http(s) only, and no
# credentials in it — a URL with userinfo is refused and its credential redacted.
# A query string or fragment is dropped; a missing trailing slash is added.
# @type=url
BASES_MCP_WEBDAV_URL=

# Basic-auth username. Required together with the password when the URL is set;
# either one without the URL is a startup refusal.
# @required=not(isEmpty($BASES_MCP_WEBDAV_URL))
# @auditIgnore
BASES_MCP_WEBDAV_USER=

# Basic-auth password. Never logged, never echoed in an error.
# @sensitive
# @required=not(isEmpty($BASES_MCP_WEBDAV_URL))
# @auditIgnore
BASES_MCP_WEBDAV_PASSWORD=

# --- the MCP transport -----------------------------------------------------

# The HTTP transport has no authentication, no authorization and no rate
# limiting: anyone who can open the socket can call every tool, including the
# two that write. The boundary is where the port is published, not where the
# server binds. Bind 0.0.0.0 only on a network you trust.

# Which transport to serve. Unset is stdio.
# @type=enum(stdio, http)
MCP_TRANSPORT=

# HTTP transport only: the bind address. Also decides which Host headers are
# served — a specific address is served on that address and on localhost, while
# 0.0.0.0 serves every Host header and makes the listener network-accessible.
# Unset binds 127.0.0.1.
# @example=127.0.0.1
MCP_HTTP_HOST=

# HTTP transport only: the bind port. 0 asks the kernel for a free port, and the
# server announces the port it chose. Unset is 8765.
# @type=number
# @example=8765
MCP_HTTP_PORT=

# --- the audit trail -------------------------------------------------------

# File the audit trail is written to. Unset writes to stderr, and nothing
# rotates stderr. The file is created 0600; the previous generation is kept at
# <path>.1.
# @example=/var/log/bases-mcp/audit.log
# @auditIgnore
MCP_AUDIT_LOG=

# Rollover threshold in MEGABYTES. One previous generation is kept, so the disk
# cost is twice this. Does nothing without MCP_AUDIT_LOG. Unset is 5.
# @type=number
# @example=5
# @auditIgnore
MCP_AUDIT_LOG_MAX_MB=

# --- development and parity gates ------------------------------------------

# The Obsidian CLI the parity tests and the recorder invoke.
# @example=obsidian
OBSIDIAN_BIN=

# The Obsidian-registered vault name the recorder reads.
# @example=vault
OBSIDIAN_VAULT=

# Set to 1 to let the parity suite accept an unverified run deliberately.
# @type=enum(0, 1)
BASES_MCP_ALLOW_SKIP=

# The directory holding Obsidian's own `obsidian.json`. Unset follows
# `XDG_CONFIG_HOME`.
# @example=~/.config/obsidian
OBSIDIAN_CONFIG_DIR=

# A built image for the opt-in container matrix. Unset SKIPS that suite.
# @example=localhost/bases-mcp:latest
BASES_MCP_CONTAINER_IMAGE=

# The OCI runtime for hosts whose system crun predates their kernel.
# @example=/path/to/crun
BASES_MCP_CONTAINER_RUNTIME=
