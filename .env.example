# Machine-specific settings. Copy to `.env` and edit; `.env` is gitignored.
#
# Nothing here is required to build or to run the unit tests. It is only read by
# the Obsidian-CLI gates and by the WebDAV backend. The MCP transport variables
# are read by the server itself, on every run.

# -- the vault ---------------------------------------------------------------

# Vault path the Obsidian CLI should be pointed at. The CLI resolves a vault by
# the name it was registered under, not by path, so this is used by
# `scripts/parity-record` to check that the right vault is registered.
BASES_MCP_VAULT_PATH=

# A live WebDAV server, for the WebDAV parity and integration tests. Absent
# means those tests skip, visibly.
BASES_MCP_WEBDAV_URL=
BASES_MCP_WEBDAV_USER=
BASES_MCP_WEBDAV_PASSWORD=

# -- the MCP transport -------------------------------------------------------
#
# The server is one binary with two transports; see docs/tooling.md for the
# whole surface and docs/divergences.md for the accepted security gap.

# Which transport to serve. Unset is `stdio`.
#   stdio   one client over stdin/stdout
#   http    any number of clients over Streamable HTTP (SSE)
MCP_TRANSPORT=

# HTTP transport only. The endpoint is http://HOST:PORT/mcp.
#
# Both refuse a value they cannot use rather than falling back: a typo'd bind
# address or a blank port is a refusal naming the variable and the value.
#
# `MCP_HTTP_HOST` also decides which `Host` headers rmcp serves. A specific
# address is served on that address and on localhost; 0.0.0.0 serves every Host
# header, which makes the listener network-accessible with no authentication.
# Bind 0.0.0.0 only on a network you trust.
MCP_HTTP_HOST=
MCP_HTTP_PORT=

# -- the audit trail --------------------------------------------------------
#
# The server records every tool call: who called it, from where, what it
# acted on, and what came of it. It never records note contents, the text an
# agent sent, or a credential.
#
# Unset, the trail goes to stderr — where nothing rotates it. A container
# whose stderr is the runtime's log would therefore grow without bound, so a
# deployment names a FILE here; see compose.yaml.
MCP_AUDIT_LOG=

# The size at which the trail file rolls over, in MEGABYTES. One previous
# generation is kept, so the disk cost is twice this.
#
# The default (5 MB) lives in the binary and applies when this is unset. The
# value here is the DEPLOYMENT's choice, and it is spelled out so the setting
# is visible where the deployment is configured rather than buried in a
# default nobody reads.
#
# This does nothing without MCP_AUDIT_LOG, and the server says so at startup
# rather than accepting it silently.
MCP_AUDIT_LOG_MAX_MB=
