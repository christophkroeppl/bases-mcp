# Obsidian writes its per-vault workspace state into the vault. The testing
# vault is content we control, so this must never be committed.
test/vault/.obsidian/

# Machine-specific settings for the Obsidian CLI and any WebDAV server. The
# example file is committed; the real one never is, because it holds paths that
# differ per machine and, on the WebDAV side, credentials.
.env
.env.*
!.env.example

# Rust
/target/

# Scratch notes kept while developing; not part of the deliverable.
scratch/
